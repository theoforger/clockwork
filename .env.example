# Copy to .env to override docker-compose defaults.

# Browser-reachable URL of the api service (baked into the web bundle at
# build time as VITE_API_BASE_URL). Must match the published api port.
API_BASE_URL=http://localhost:3000

# Browser-reachable URL of the web service (passed to the api as
# ALLOW_ORIGIN for CORS). Must match the published web port.
WEB_BASE_URL=http://localhost:8080

# How often (in seconds) the api sweeps expired events. Defaults to 3600
# (1 hour) if unset.
EVENT_CLEANUP_INTERVAL_SECS=3600
